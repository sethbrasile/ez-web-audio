{
  "name": "ez-web-audio",
  "type": "module",
  "version": "0.2.0",
  "description": "A zero-dependency TypeScript library that makes the Web Audio API easy. Play sounds, synthesizers, drum machines, and audio effects with minimal code.",
  "author": {
    "name": "Seth Brasile",
    "email": "seth.brasile@gmail.com",
    "url": "https://github.com/sethbrasile"
  },
  "license": "MIT",
  "homepage": "https://sethbrasile.github.io/ez-web-audio",
  "repository": {
    "type": "git",
    "url": "https://github.com/sethbrasile/ez-web-audio.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/sethbrasile/ez-web-audio/issues"
  },
  "keywords": [
    "audio",
    "web",
    "audio-api",
    "web-audio",
    "web-audio-api",
    "audio-context",
    "audio-node",
    "synthesis",
    "oscillator",
    "drum-machine",
    "synthesizer",
    "soundfont",
    "audio-sprite",
    "beat",
    "rhythm",
    "filter",
    "sampler",
    "envelope",
    "effects",
    "typescript"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "prepublishOnly": "pnpm typecheck && pnpm test --run && pnpm build"
  },
  "devDependencies": {
    "happy-dom": "^20.6.1",
    "standardized-audio-context": "^25.3.77",
    "standardized-audio-context-mock": "^9.7.9",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  }
}
