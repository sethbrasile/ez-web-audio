{
  "name": "@ez-web-audio/vue",
  "type": "module",
  "version": "0.2.0",
  "description": "Vue 3 composables for ez-web-audio",
  "author": { "name": "Seth Brasile", "email": "seth.brasile@gmail.com" },
  "license": "MIT",
  "homepage": "https://sethbrasile.github.io/ez-web-audio",
  "repository": { "type": "git", "url": "https://github.com/sethbrasile/ez-web-audio.git", "directory": "packages/vue" },
  "bugs": {
    "url": "https://github.com/sethbrasile/ez-web-audio/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "composables",
    "web-audio",
    "audio",
    "ez-web-audio"
  ],
  "sideEffects": false,
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["LICENSE", "README.md", "dist"],
  "engines": { "node": ">=18" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "prepublishOnly": "pnpm typecheck && pnpm test --run && pnpm build"
  },
  "peerDependencies": { "ez-web-audio": "workspace:^", "vue": "^3.4.0" },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "ez-web-audio": "workspace:*",
    "happy-dom": "^20.6.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18",
    "vue": "^3.4.0"
  }
}
