{
  "name": "ez-web-audio-workspace",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316",
  "description": "A zero-dependency TypeScript library that makes the Web Audio API easy. Play sounds, synthesizers, drum machines, and audio effects with minimal code.",
  "author": {
    "name": "Seth Brasile",
    "email": "seth.brasile@gmail.com",
    "url": "https://github.com/sethbrasile"
  },
  "license": "MIT",
  "homepage": "https://sethbrasile.github.io/ez-web-audio",
  "repository": {
    "type": "git",
    "url": "https://github.com/sethbrasile/ez-web-audio.git"
  },
  "bugs": {
    "url": "https://github.com/sethbrasile/ez-web-audio/issues"
  },
  "keywords": [
    "audio",
    "web",
    "audio-api",
    "web-audio",
    "web-audio-api",
    "audio-context",
    "audio-node",
    "synthesis",
    "oscillator",
    "drum-machine",
    "synthesizer",
    "soundfont",
    "audio-sprite",
    "beat",
    "rhythm",
    "filter",
    "sampler",
    "envelope",
    "effects",
    "typescript"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "pnpm build:lib && vitepress dev docs",
    "build": "pnpm build:lib && pnpm docs:build",
    "build:lib": "pnpm --filter ez-web-audio build",
    "docs:dev": "typedoc && vitepress dev docs",
    "docs:build": "typedoc && vitepress build docs && node scripts/patch-llms-size.mjs",
    "docs:preview": "vitepress preview docs",
    "preview": "vitepress preview docs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm -r --parallel test --run",
    "test:watch": "pnpm --filter ez-web-audio test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ez-web-audio/vue": "workspace:*",
    "ez-web-audio": "workspace:*"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.4.3",
    "@nx-js/observer-util": "^4.2.2",
    "@playwright/test": "^1.58.2",
    "eslint": "10.0.0",
    "typedoc": "^0.28.16",
    "typedoc-plugin-markdown": "^4.9.0",
    "typedoc-vitepress-theme": "^1.1.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitepress": "^1.6.4",
    "vitepress-plugin-llms": "^1.11.0"
  }
}
